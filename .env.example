# Entorno y Zona Horaria (Crítico para Ancla Temporal de IA y Cron de las 12:00 PM)
ENVIRONMENT=development
DEFAULT_TIMEZONE=America/Caracas
# En local usa 8005 para no colisionar con el puerto 8000 del API Gateway Go
PORT=8005

# Base de Datos y Redis (Par 2 Compartido desde la raíz saas/docker-compose.yml en puertos 5433/6380; en producción vía *.railway.internal)
# Índice Redis asignado en el Par 2 compartido: /1 (0..15)
DATABASE_URL=postgresql+asyncpg://reservas_user:reservas_super_secret_password_2026@127.0.0.1:5433/citas_medicas
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=15
REDIS_URL=redis://:redis_secure_password_2026@127.0.0.1:6380/1

# Seguridad Interna con el API Gateway (X-Internal-Api-Key inyectada por api-gateway-auth)
INTERNAL_GATEWAY_SECRET=clave_secreta_compartida_con_el_gateway

# Validación Criptográfica Modular de Webhooks (Passthrough desde el API Gateway)
TELEGRAM_WEBHOOK_SECRET=tu_secret_token_de_telegram_webhook
WHATSAPP_APP_SECRET=tu_app_secret_de_meta_para_hmac_sha256
WHATSAPP_VERIFY_TOKEN=tu_verify_token_para_hub_challenge

# Google Gemini API (SDK google-genai)
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
IA_MODELS=["gemini-3.5-flash", "gemini-3.7-flash", "gemini-4-hydrogen", "gemini-3.6-flash", "gemini-3.5-flash-lite"]
GEMINI_HEDGED_TIMEOUT_SECONDS=4.0

# Canales de Mensajería (Adaptadores de salida)
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_tu_token_de_botfather
TELEGRAM_BOT_USERNAME=mi_bot
WHATSAPP_ACCESS_TOKEN=opcional_para_meta_cloud_api
WHATSAPP_PHONE_NUMBER_ID=opcional_para_meta_cloud_api

# Administrador Inicial / Seed de Alembic (Opcional: da de alta automáticamente tu usuario como ADMIN al correr migraciones)
INITIAL_ADMIN_NOMBRE=Francisco
INITIAL_ADMIN_TELEGRAM_CHAT_ID=123456789
INITIAL_ADMIN_WHATSAPP_PHONE=+584121234567


